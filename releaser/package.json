{
  "name": "@okocraft/releaser",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run format:check && npm run build:check",
    "build:check": "npm run build && git diff --exit-code -- actions/prepare/dist actions/publish/dist",
    "lint": "eslint src tests",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'scripts/*.mjs' 'actions/*/action.yml' '*.json'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'scripts/*.mjs' 'actions/*/action.yml' '*.json'"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "ajv": "^8.20.0",
    "yaml": "^2.8.1",
    "yauzl": "^3.2.0",
    "fast-xml-parser": "^5.2.5"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/yauzl": "^2.10.3",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "eslint": "^10.13.0",
    "typescript-eslint": "^8.72.0",
    "prettier": "^3.6.2",
    "@eslint/js": "^10.0.1",
    "globals": "^16.4.0"
  }
}
