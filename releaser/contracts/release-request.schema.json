{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/okocraft/public-ops/blob/main/releaser/contracts/release-request.schema.json",
  "title": "Releaser release request (v1)",
  "description": "Immutable release intent; repository visibility and publication authorization are checked independently.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "version",
    "target_sha"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^okocraft/[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 100,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "target_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
