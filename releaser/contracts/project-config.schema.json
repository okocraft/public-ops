{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/okocraft/public-ops/blob/main/releaser/contracts/project-config.schema.json",
  "title": "Releaser target repository configuration (v1)",
  "description": "Stored at .github/releaser.json in the target repository and read from target_sha.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "build",
    "tag_prefix",
    "assets"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "tag_prefix": {
      "type": "string",
      "enum": [
        "",
        "v"
      ]
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool",
        "java_version",
        "arguments"
      ],
      "properties": {
        "tool": {
          "type": "string",
          "enum": [
            "gradle",
            "maven"
          ]
        },
        "java_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]?$"
        },
        "arguments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "pattern": "^[A-Za-z0-9:._=/-]+$"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "name"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_./{}+\\-]+$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 150,
            "pattern": "^[A-Za-z0-9_.{}+\\-]+$"
          }
        }
      }
    }
  }
}
